# Neon Postgres for Prisma in serverless/Vercel.
# Use the pooled connection string (with -pooler in host) for DATABASE_URL.
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@ep-[PROJECT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# Use the direct unpooled connection string for DIRECT_URL.
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@ep-[PROJECT].[REGION].aws.neon.tech/neondb?sslmode=require"

# Required for /admin.
ADMIN_PASSWORD="choose-a-strong-parent-password"
ADMIN_SESSION_SECRET="choose-a-long-random-session-secret"

